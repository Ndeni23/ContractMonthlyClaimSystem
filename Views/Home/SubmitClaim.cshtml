@using ContractMonthlyClaimSystem.ViewModel
@model ClaimViewModel
@{
    ViewData["Title"] = "Submit New Claim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">Submit New Monthly Claim</h3>

                <form asp-action="SubmitClaim" method="post" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoursWorked" class="form-label"></label>
                            <input asp-for="HoursWorked" type="number" step="0.1" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HourlyRate" class="form-label"></label>
                            <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="supportingDocument" class="form-label">Upload Supporting Document (e.g., Timesheet)</label>
                        <input name="supportingDocument" id="supportingDocument" type="file" class="form-control" />
                        <small class="form-text text-muted">Allowed formats: .pdf, .docx, .xlsx</small>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Submit Claim for Approval</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>