@model IEnumerable<ContractMonthlyClaimSystem.Models.Claim>

@{
    ViewData["Title"] = "HR Payroll Report";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="fas fa-file-invoice-dollar"></i> Approved Claims Report</h2>
        <button onclick="window.print()" class="btn btn-success">
            <i class="fas fa-print"></i> Generate Invoice / Print Report
        </button>
    </div>

    <div class="alert alert-info">
        <strong>HR Status:</strong> This report lists all claims that have been fully approved by Academic Managers and are ready for payment processing.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Claim ID</th>
                        <th>Lecturer Name</th>
                        <th>Module / Description</th>
                        <th>Hours</th>
                        <th>Rate</th>
                        <th>Total Payout</th>
                        <th>Date Approved</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.ClaimId</td>
                                <td>@(item.Lecturer != null ? item.Lecturer.FirstName + " " + item.Lecturer.LastName : "Unknown")</td>
                                <td>@item.Comments</td>
                                <td>@item.HoursWorked</td>
                                <td>R @item.HourlyRate</td>
                                <td class="fw-bold text-success">R @item.TotalAmount</td>
                                <td>@DateTime.Now.ToShortDateString()</td>
                            </tr>
                        }
                        <tr class="table-active fw-bold">
                            <td colspan="5" class="text-end">TOTAL PAYROLL:</td>
                            <td colspan="2" class="text-success">
                                R @Model.Sum(i => i.TotalAmount)
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No approved claims found for payment processing.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>