<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-g" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ContractMonthlyClaimSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ContractMonthlyClaimSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- V V V THIS IS THE CORRECTED LINK V V V -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Login">ContractMonthlyClaimSystem</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var userRole = ViewData["UserRole"] as string;
                    }

                    <!-- Main Navigation links -->
                    <ul class="navbar-nav flex-grow-1">
                        @if (userRole == "Lecturer")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="LecturerDashboard">Track Claims</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="SubmitClaim">Submit Claim</a>
                            </li>
                        }
                        else if (userRole == "Programme Coordinator")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="AdminDashboard">Pre-Approve Claims</a>
                            </li>
                        }
                        else if (userRole == "Academic Manager")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="ManagerDashboard">Final Approval</a>
                            </li>
                        }
                    </ul>

                    <!-- Welcome & Logout section -->
                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-3">
                                    Welcome, <strong>@userRole</strong>
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Logout">Logout</a>
                            </li>
                        }
                    </ul>
                </div>
            </div> <!-- THIS IS THE MISSING CLOSING TAG -->
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - ContractMonthlyClaimSystem
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>