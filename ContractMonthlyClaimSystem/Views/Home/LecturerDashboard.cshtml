@model IEnumerable<ContractMonthlyClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Track My Claims";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>My Claims History</h3>
    <a asp-action="SubmitClaim" class="btn btn-primary">Submit New Claim</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Claim ID</th>
            <th>Submission Date</th>
            <th>Description</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th>Document</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.ClaimId</td>
                    <td>@claim.SubmissionDate.ToShortDateString()</td>
                    <td>@claim.Comments</td>
                    <td>@claim.TotalAmount.ToString("C", new System.Globalization.CultureInfo("en-ZA"))</td>
                    <td>
                        @{
                            var statusClass = claim.Status == "Submitted" ? "bg-warning text-dark" :
                            (claim.Status == "Pre-approved" ? "bg-info text-dark" :
                            (claim.Status == "Approved" ? "bg-success" : "bg-danger"));
                        }
                        <span class="badge @statusClass">@claim.Status</span>
                    </td>
                    <td>
                        @if (claim.SupportingDocuments != null && claim.SupportingDocuments.Any())
                        {
                            // In a real app, this would be a download link. For now, it just displays the name.
                            <span>@claim.SupportingDocuments.First().FileName</span>
                        }
                        else
                        {
                            <span class="text-muted">No document</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">You have not submitted any claims yet.</td>
            </tr>
        }
    </tbody>
</table>